---
import { getCollection } from 'astro:content';

const ingredients = (await getCollection('ingredients'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Browse community ingredients for EPrints repositories." />
    <title>EPrints Ingredients</title>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <p class="eyebrow">EPrints community directory</p>
        <h1>Ingredients</h1>
        <p class="intro">Discover add-ons and features for EPrints repositories.</p>
        <label class="search-label" for="ingredient-search">Search ingredients</label>
        <input
          id="ingredient-search"
          class="search"
          type="search"
          placeholder="Search by name, creator, description, or version..."
          autocomplete="off"
        />
      </header>

      <section aria-label="Ingredient listings">
        <p id="result-count" class="result-count" aria-live="polite">
          {ingredients.length} {ingredients.length === 1 ? 'ingredient' : 'ingredients'}
        </p>
        <div id="ingredient-list" class="grid">
          {ingredients.map(({ data: ingredient }) => (
            <article class="card" data-search-text={[
              ingredient.name,
              ingredient.creator,
              ingredient.description,
              ingredient.latest_eprints_version_tested,
            ].join(' ').toLowerCase()}>
              <div class="card-heading">
                <h2>{ingredient.name}</h2>
                {ingredient.latest_eprints_version_tested && (
                  <span class="version">EPrints {ingredient.latest_eprints_version_tested}</span>
                )}
              </div>
              {ingredient.creator && <p class="creator">By {ingredient.creator}</p>}
              {ingredient.description && <p class="description">{ingredient.description}</p>}
              {ingredient.repo_url && (
                <a class="repo-link" href={ingredient.repo_url} target="_blank" rel="noopener noreferrer">
                  View repository <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))}
          <p id="no-results" class="no-results" hidden>No ingredients match your search.</p>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#ingredient-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
  const resultCount = document.querySelector<HTMLElement>('#result-count');
  const noResults = document.querySelector<HTMLElement>('#no-results');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    for (const card of cards) {
      const matches = card.dataset.searchText?.includes(query) ?? false;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    if (resultCount) {
      resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'ingredient' : 'ingredients'}`;
    }
    if (noResults) noResults.hidden = visibleCount > 0;
  });
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f5f7fb;
    color: #172033;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .page {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 5rem;
  }

  .page-header {
    max-width: 720px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.6rem;
    color: #2563a6;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.05em;
  }

  .intro {
    margin: 0.8rem 0 2rem;
    color: #526078;
    font-size: 1.1rem;
  }

  .search-label {
    display: block;
    margin-bottom: 0.5rem;
    color: #34425a;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: left;
  }

  .search {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid #cbd4e1;
    border-radius: 0.75rem;
    background: #fff;
    color: inherit;
    font: inherit;
    box-shadow: 0 4px 14px rgb(23 32 51 / 5%);
  }

  .search:focus {
    border-color: #2563a6;
    outline: 3px solid rgb(37 99 166 / 18%);
  }

  .result-count {
    margin: 0 0 0.9rem;
    color: #647189;
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.4rem;
    border: 1px solid #e0e6ef;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 8px 24px rgb(23 32 51 / 5%);
  }

  .card[hidden] {
    display: none;
  }

  .card-heading {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  h2 {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .version {
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: #eaf3ff;
    color: #22578d;
    font-size: 0.75rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .creator {
    margin: 0.55rem 0 0;
    color: #647189;
    font-size: 0.9rem;
  }

  .description {
    margin: 1rem 0;
    color: #3e4a60;
    line-height: 1.6;
  }

  .repo-link {
    margin-top: auto;
    color: #205b99;
    font-weight: 650;
    text-decoration: none;
  }

  .repo-link:hover {
    text-decoration: underline;
  }

  .no-results {
    grid-column: 1 / -1;
    margin: 1rem 0;
    color: #647189;
    text-align: center;
  }

  @media (max-width: 600px) {
    .page {
      padding-top: 2.5rem;
    }
  }
</style>